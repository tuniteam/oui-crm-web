# URL de base de l'API oui-crm (préfixe global inclus).
# Ports locaux distincts de soft-m (API 3000, front 5173) pour faire
# tourner les deux projets en parallèle : ici API 3001, front 5174.
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Base publique du front (sous-chemin de déploiement). '/' en local.
VITE_BASE_URL=/
