# =============================================================================
# Docker Ignore File
# Files and directories to exclude from Docker build context
# =============================================================================

# Dependencies
node_modules

# Build output
dist
build

# Git
.git
.gitignore

# IDE
.idea
.vscode
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Environment files (sensitive - use build args instead)
.env
.env.local
.env.dev
.env.uat
.env.prod
.env.*.local

# Test coverage
coverage

# Docker files (avoid recursive copies)
Dockerfile*
docker-compose*.yml

# Documentation
*.md
LICENSE

# Claude config
.claude